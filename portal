<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta http-equiv="Cache-Control" content="no-store, no-cache, must-revalidate, max-age=0">
  <meta http-equiv="Pragma" content="no-cache">
  <meta http-equiv="Expires" content="0">
  <title>Client Portal Temporarily Unavailable</title>
  <script>
    try {
      localStorage.removeItem('cp_accounts_backup_v1');
      localStorage.removeItem('cp_session_v1');
      sessionStorage.removeItem('cp_accounts_backup_v1');
      sessionStorage.removeItem('cp_session_v1');
    } catch (_) {}
  </script>
  <style>
    :root { color-scheme: light; font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
    * { box-sizing: border-box; }
    body { margin: 0; min-height: 100vh; display: grid; place-items: center; padding: 24px; color: #172033; background: #f3f7fa; }
    main { width: min(620px, 100%); padding: 36px; border: 1px solid #dbe4ea; border-radius: 18px; background: #fff; box-shadow: 0 18px 50px rgba(22, 46, 72, .10); }
    .logo { display: grid; place-items: center; width: 64px; height: 64px; margin-bottom: 24px; border-radius: 16px; color: #fff; background: #16a9cc; font-weight: 800; letter-spacing: .04em; }
    h1 { margin: 0 0 12px; font-size: clamp(26px, 5vw, 36px); line-height: 1.15; }
    p { margin: 0; color: #536276; font-size: 17px; line-height: 1.65; }
    .note { margin-top: 22px; padding-top: 18px; border-top: 1px solid #e6edf2; font-size: 14px; }
  </style>
</head>
<body>
  <main>
    <div class="logo" aria-hidden="true">ANY</div>
    <h1>Client portal temporarily unavailable</h1>
    <p>We are completing an urgent security update. Please do not attempt to sign in until you receive confirmation that access has been restored.</p>
    <p class="note">If you need immediate assistance, contact your Anytime Work account manager through your usual channel.</p>
  </main>
</body>
</html>
